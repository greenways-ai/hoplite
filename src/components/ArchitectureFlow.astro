---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const artworkBase = "https://opensource.greenways.ai/visual-language/artwork/hoplite/";
---
<section class="home-section home-architecture">
  <header><p class="technical-kicker">01 · Package to production</p><h2>Configure once. Run anywhere.</h2><p>Pull a project from GitHub, resolve its signed Hara packages, and build the same locked Hoplite service for a local process or container.</p></header>
  <div class="request-flow" aria-label="A GitHub project is resolved, composed, built, and run by Hoplite">
    <span><small>PULL</small><b>GitHub</b><em>source</em></span><i>→</i>
    <span><small>RESOLVE</small><b>Hara</b><em>packages</em></span><i>→</i>
    <span class="request-flow__core"><small>COMPOSE</small><b>project.edn</b><em>profile</em></span><i>→</i>
    <span><small>PACKAGE</small><b>Docker</b><em>OCI image</em></span><i>→</i>
    <span><small>DEPLOY</small><b>Hoplite</b><em>gateway</em></span>
  </div>
  <a class="technical-link" href={`${base}getting-started/development-workflow/`}>Follow the Git-to-runtime workflow →</a>
</section>
<figure class="mosaic-feature">
  <ThemedArtwork
    class="mosaic-feature__art"
    light={`${artworkBase}open-gate-day.webp`}
    dark={`${artworkBase}open-gate-night.webp`}
    lightMobile={`${artworkBase}open-gate-day-mobile.webp`}
    darkMobile={`${artworkBase}open-gate-night-mobile.webp`}
    lightAlt="A rabbit paused midway through a sunlit garden gate"
    darkAlt="A rabbit sheltered inside a moonlit gatehouse niche"
    position="center"
  />
  <figcaption>An explicit gate keeps every host capability visible.</figcaption>
</figure>
