---
import SharedHeader from "@greenways-ai/visual-language/SharedHeader.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const searchBase = base.replace(/\/$/, "");
---
<SharedHeader
  project="hoplite"
  title="Hoplite"
  homeHref={base}
  searchBase={searchBase}
  nav={[
    { label: "Start", href: `${base}getting-started/` },
    { label: "Concepts", href: `${base}concepts/runtime-model/` },
    { label: "Guides", href: `${base}guides/production-operation/` },
    { label: "Reference", href: `${base}reference/cli/` },
  ]}
  githubHref="https://github.com/greenways-ai/hoplite"
/>
