---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";
const install = "git clone https://github.com/greenways-ai/hoplite.git";
---
<section class="hoplite-hero">
  <ThemedArtwork class="hoplite-hero__art" light="/images/hoplite-squad-day.webp" dark="/images/hoplite-squad-night.webp" lightAlt="A Hoplite squad training together and helping citizens build fast, adaptable civic infrastructure" darkAlt="The same squad rapidly reconfiguring its formation to contain an abstract breach at night" position="center" />
  <div class="hoplite-hero__veil"></div>
  <div class="hoplite-hero__copy">
    <p class="technical-kicker"><i></i> Open foundation · pre-release</p>
    <h1>Small. Fast. Yours.</h1>
    <p>Hoplite is a lightweight, high-performance and deeply customizable Nginx application container. Immutable resource trees and startup-compiled handlers keep the runtime lean while leaving the application shape in your hands.</p>
    <div class="hero-links">
      <a class="action action--gold" href="/getting-started/">Get started <span>→</span></a>
      <a class="action" href="/reference/cli/">Read the reference</a>
      <a class="action" href="https://github.com/greenways-ai/hoplite">Source ↗</a>
    </div>
    <div class="hero-command"><code>{install}</code><span>macOS-first · EPL-2.0</span></div>
  </div>
</section>
