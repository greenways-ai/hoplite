---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";

const concepts = ["rabbit-courtyard", "open-gate", "branching-paths", "wind-arcade"];
const artworkBase = "https://oss.greenways.ai/visual-language/artwork/hoplite/";
---

<section class="world-catalogue">
  <header>
    <p class="technical-kicker">05 · Freedom in motion</p>
    <h2>Four expressions of air,<br />choice and speed.</h2>
  </header>
  <div>
    {concepts.map((concept) => (
      <article>
        <ThemedArtwork
          light={`${artworkBase}${concept}-day.webp`}
          dark={`${artworkBase}${concept}-night.webp`}
          lightMobile={`${artworkBase}${concept}-day-mobile.webp`}
          darkMobile={`${artworkBase}${concept}-night-mobile.webp`}
          lightAlt={`${concept.replaceAll("-", " ")} by day`}
          darkAlt={`${concept.replaceAll("-", " ")} at night`}
        />
        <h3>{concept.replaceAll("-", " ")}</h3>
      </article>
    ))}
  </div>
</section>

<style>
  .world-catalogue { width: min(100% - 3rem, 1280px); margin: 80px auto; }
  .world-catalogue h2 { font: 400 clamp(3rem, 7vw, 6rem)/.9 "Marcellus", Georgia, serif; }
  .world-catalogue > div { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .world-catalogue article { overflow: hidden; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg-nav); }
  .world-catalogue article > div { aspect-ratio: 3 / 2; }
  .world-catalogue h3 { margin: 0; padding: 15px; text-transform: capitalize; }

  @media (max-width: 680px) {
    .world-catalogue { width: calc(100% - 1.5rem); }
    .world-catalogue > div { grid-template-columns: 1fr; }
    .world-catalogue article > div { aspect-ratio: 3 / 4; }
  }
</style>
