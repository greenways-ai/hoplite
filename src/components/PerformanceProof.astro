---
import CodePanel from "@greenways-ai/visual-language/CodePanel.astro";
import benchmark from "../data/http-benchmark.json";

const measured = benchmark.status === "measured";
const hoplite = benchmark.targets.hoplite;
const nginx = benchmark.targets.nginx;
const number = (value: number | null, digits = 0) =>
  value == null ? "—" : value.toLocaleString("en-US", { minimumFractionDigits: digits, maximumFractionDigits: digits });
const generated = benchmark.generatedAt
  ? new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(new Date(benchmark.generatedAt)) + " UTC"
  : "measurement pending";
const commit = benchmark.commit ? benchmark.commit.slice(0, 8) : "pending";
const ratio = benchmark.comparison.throughputPercentOfNginx == null
  ? "—"
  : `${number(benchmark.comparison.throughputPercentOfNginx, 1)}%`;
const recipe = `docker build -f docker/Dockerfile.nginx-baseline -t hoplite-nginx-baseline .

bash scripts/benchmark-http.sh \\
  ghcr.io/greenways-ai/hoplite:latest \\
  hoplite-nginx-baseline \\
  benchmark-output/http-benchmark.json`;
const comparisons = [
  {
    label: "Requests / second",
    hoplite: number(hoplite.metrics.requestsPerSecond),
    nginx: number(nginx.metrics.requestsPerSecond),
    detail: measured ? `Hoplite delivers ${ratio} of the raw Nginx request rate in this sample.` : "Measurement pending.",
  },
  {
    label: "p50 latency",
    hoplite: hoplite.metrics.latencyP50Ms == null ? "—" : `${number(hoplite.metrics.latencyP50Ms, 2)} ms`,
    nginx: nginx.metrics.latencyP50Ms == null ? "—" : `${number(nginx.metrics.latencyP50Ms, 2)} ms`,
    detail: "Median request latency under the same thread and connection load.",
  },
  {
    label: "p99 latency",
    hoplite: hoplite.metrics.latencyP99Ms == null ? "—" : `${number(hoplite.metrics.latencyP99Ms, 2)} ms`,
    nginx: nginx.metrics.latencyP99Ms == null ? "—" : `${number(nginx.metrics.latencyP99Ms, 2)} ms`,
    detail: "Tail latency from the same three-round wrk sample.",
  },
  {
    label: "Peak memory under load",
    hoplite: hoplite.metrics.peakMemoryMiB == null ? "—" : `${number(hoplite.metrics.peakMemoryMiB, 1)} MiB`,
    nginx: nginx.metrics.peakMemoryMiB == null ? "—" : `${number(nginx.metrics.peakMemoryMiB, 1)} MiB`,
    detail: "Highest container memory sample observed while each target was loaded.",
  },
];
const targetFootprints = [hoplite, nginx];
const roundRows = [
  ...hoplite.samples.map((sample) => ({ target: "Hoplite", ...sample })),
  ...nginx.samples.map((sample) => ({ target: "Plain Nginx", ...sample })),
];
---

<section id="performance" class="home-section performance-proof">
  <header>
    <p class="technical-kicker">02 · Equivalent-payload benchmark</p>
    <h2>Hoplite against raw Nginx.</h2>
    <p>
      Both targets use Nginx 1.30.4, the same Debian toolchain, the same 19-byte body,
      the same response header, and the same load generator. The difference is the
      embedded Hara application path.
    </p>
  </header>

  <div class="benchmark-equivalence">
    <div>
      <small>Payload</small>
      <code>Hello from Hoplite\n</code>
    </div>
    <div>
      <small>Body</small>
      <strong>{benchmark.payload.bodyBytes} bytes</strong>
    </div>
    <div>
      <small>Response identity</small>
      <strong>{benchmark.payload.sha256 ? "SHA-256 matched" : "Pending"}</strong>
    </div>
    <div>
      <small>Load</small>
      <strong>{benchmark.load.threads} threads · {benchmark.load.connections} connections · {benchmark.load.duration}</strong>
    </div>
  </div>

  <div class="benchmark-comparison" data-benchmark-status={benchmark.status}>
    {comparisons.map((metric) => (
      <article>
        <p>{metric.label}</p>
        <div class="benchmark-target-value benchmark-target-value--hoplite">
          <small>Hoplite</small>
          <strong>{metric.hoplite}</strong>
        </div>
        <div class="benchmark-target-value">
          <small>Plain Nginx</small>
          <strong>{metric.nginx}</strong>
        </div>
        <span>{metric.detail}</span>
      </article>
    ))}
  </div>

  <div class="benchmark-footprints" aria-label="Measured target footprint">
    {targetFootprints.map((target) => (
      <article>
        <h3>{target.label}</h3>
        <dl>
          <div><dt>Runtime executable</dt><dd>{target.executableSizeMiB == null ? "—" : `${number(target.executableSizeMiB, 1)} MiB`}</dd></div>
          <div><dt>Deployment image</dt><dd>{target.imageSizeMiB == null ? "—" : `${number(target.imageSizeMiB, 1)} MiB`}</dd></div>
          <div><dt>Idle memory</dt><dd>{target.idleMemoryMiB == null ? "—" : `${number(target.idleMemoryMiB, 1)} MiB`}</dd></div>
        </dl>
      </article>
    ))}
  </div>

  {measured && roundRows.length > 0 && (
    <details class="benchmark-rounds">
      <summary>All measured rounds</summary>
      <div>
        <table>
          <thead>
            <tr>
              <th>Target</th>
              <th>Round</th>
              <th>Requests/s</th>
              <th>p50</th>
              <th>p99</th>
              <th>Peak memory</th>
            </tr>
          </thead>
          <tbody>
            {roundRows.map((sample) => (
              <tr>
                <td>{sample.target}</td>
                <td>{sample.round}</td>
                <td>{number(sample.requestsPerSecond)}</td>
                <td>{number(sample.latencyP50Ms, 2)} ms</td>
                <td>{number(sample.latencyP99Ms, 2)} ms</td>
                <td>{number(sample.peakMemoryMiB, 1)} MiB</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}

  <div class="benchmark-provenance">
    <dl>
      <div><dt>Recorded</dt><dd>{generated}</dd></div>
      <div><dt>Commit</dt><dd><code>{commit}</code></dd></div>
      <div><dt>Runner</dt><dd>{benchmark.runner || "pending"}</dd></div>
      <div><dt>CPU</dt><dd>{benchmark.cpu || "pending"} · {benchmark.logicalCpus || "—"} logical</dd></div>
      <div><dt>Rounds</dt><dd>{benchmark.load.rounds} per target</dd></div>
      <div><dt>Isolation</dt><dd>Targets run sequentially on one runner</dd></div>
    </dl>
    <p>
      This is a reproducible release sample, not a universal capacity guarantee. The
      comparison is useful because the payload, Nginx version, build environment and
      load are held constant.
    </p>
  </div>

  <div class="benchmark-recipe">
    <div>
      <p class="panel-label">Reproduce the comparison</p>
      <h3>Build both targets and record both sides.</h3>
      <p>
        The script rejects the run when the response bodies differ, then records every
        round along with executable size, image size, idle memory and peak memory.
      </p>
    </div>
    <CodePanel
      class="benchmark-code-panel"
      code={recipe}
      lang="bash"
      title="Hoplite vs plain Nginx"
      meta="same payload · same load"
      compact
    />
  </div>
</section>
