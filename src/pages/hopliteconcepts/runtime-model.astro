---
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const destination = `${base}concepts/runtime-model/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={destination} />
    <link rel="icon" type="image/svg+xml" href="/hoplite/favicon.svg" />
    <meta property="og:image" content="https://opensource.greenways.ai/visual-language/assets/og-hoplite.png" />
    <meta property="og:image:alt" content="Hoplite's cyan compass-star sigil over the rabbit courtyard" />
    <meta name="twitter:image" content="https://opensource.greenways.ai/visual-language/assets/og-hoplite.png" />
    <meta name="twitter:image:alt" content="Hoplite's cyan compass-star sigil over the rabbit courtyard" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Redirecting to Hoplite runtime model</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(
        destination + window.location.search + window.location.hash,
      );
    </script>
  </head>
  <body>
    <p>
      <img src="/hoplite/sigil.svg" alt="Hoplite sigil" width="48" height="48" />
    </p>
    <p>
      This documentation address has moved to
      <a href={destination}>Hoplite’s runtime model</a>.
    </p>
  </body>
</html>
