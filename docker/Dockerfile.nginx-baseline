ARG NGINX_VERSION=1.30.4

FROM debian:bookworm-slim AS builder
ARG NGINX_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl libpcre2-dev libssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl -fsSLO "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" \
    && tar -xzf "nginx-${NGINX_VERSION}.tar.gz" \
    && cd "nginx-${NGINX_VERSION}" \
    && ./configure --prefix=/opt/nginx \
         --with-http_ssl_module --with-threads \
    && make -j"$(nproc)" \
    && make install

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libpcre2-8-0 libssl3 zlib1g \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system nginx && useradd --system --gid nginx --home /nonexistent nginx \
    && mkdir -p /tmp/nginx/client /tmp/nginx/proxy /tmp/nginx/fastcgi /tmp/nginx/uwsgi /tmp/nginx/scgi \
    && chown -R nginx:nginx /tmp/nginx
COPY --from=builder /opt/nginx /opt/nginx
COPY docker/nginx-baseline.conf /opt/nginx/conf/nginx.conf
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD curl --fail --silent http://127.0.0.1:8080/hello >/dev/null || exit 1
ENTRYPOINT ["/opt/nginx/sbin/nginx", "-g", "daemon off;"]
