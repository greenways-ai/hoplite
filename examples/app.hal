(ns hoplite.app
  (:require [hoplite.core :as h]))

(defn hello
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite" "true"}
   :body "Hello from Hoplite\n"})

(defn ^:async delayed
  [request]
  (std.foundation.coroutine/await
    (std.native.Host/call "nginx" "sleep" [25]))
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite" "promise-resumed"}
   :body "Hara coroutine resumed from the Nginx event loop\n"})

(defn inspect
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"}
   :body "inspect"})

(def app
  (h/app
    {:name "example"
     :resources
     [["/hello"
       {:get {:name "hello"
              :summary "A synchronous response"
              :handler #'hello}}]
      ["/delay"
       {:get {:name "delay"
              :summary "A coroutine resumed by nginx"
              :handler #'delayed}}]
      ["/inspect"
       {:get {:name "inspect"
              :handler #'inspect}}]]}))
