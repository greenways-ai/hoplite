#!/usr/bin/env python3
"""Make the native callback test fixtures explicit under Rust 2024 unsafe rules.

The production bridge already contains narrow unsafe blocks. These exact,
idempotent replacements apply the same discipline to the test-only callback
fixtures without weakening `#![deny(unsafe_op_in_unsafe_fn)]` for the crate.
"""

from __future__ import annotations

from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SOURCE = ROOT / "core/abi/data-plane-ffi/src/implementation.rs"


def replace_exact(source: str, old: str, new: str, expected: int, label: str) -> str:
    if new in source:
        return source
    count = source.count(old)
    if count != expected:
        raise SystemExit(f"{label}: expected {expected} anchors, found {count}")
    return source.replace(old, new)


def main() -> None:
    source = SOURCE.read_text(encoding="utf-8")

    source = replace_exact(
        source,
        "        let context = &mut *(context as *mut RequestContext);",
        "        // SAFETY: test descriptors point at a live request context for the callback lifetime.\n"
        "        let context = unsafe { &mut *(context as *mut RequestContext) };",
        2,
        "request context dereference",
    )
    source = replace_exact(
        source,
        "        let context = &mut *(context as *mut ResponseContext);",
        "        // SAFETY: test descriptors point at a live response context for the callback lifetime.\n"
        "        let context = unsafe { &mut *(context as *mut ResponseContext) };",
        2,
        "response context dereference",
    )
    source = replace_exact(
        source,
        "            slice::from_raw_parts_mut(output, capacity)[..count]\n"
        "                .copy_from_slice(&context.bytes[context.cursor..context.cursor + count]);",
        "            // SAFETY: the bridge supplies a writable output buffer of `capacity` bytes.\n"
        "            let output = unsafe { slice::from_raw_parts_mut(output, capacity) };\n"
        "            output[..count]\n"
        "                .copy_from_slice(&context.bytes[context.cursor..context.cursor + count]);",
        1,
        "request output buffer",
    )
    source = replace_exact(
        source,
        "            slice::from_raw_parts_mut(output, capacity)[..count]\n"
        "                .copy_from_slice(&context.bytes[offset..offset + count]);",
        "            // SAFETY: the bridge supplies a writable output buffer of `capacity` bytes.\n"
        "            let output = unsafe { slice::from_raw_parts_mut(output, capacity) };\n"
        "            output[..count].copy_from_slice(&context.bytes[offset..offset + count]);",
        1,
        "response output buffer",
    )
    source = replace_exact(
        source,
        "        *returned = if context.overread {\n"
        "            capacity.saturating_add(1)\n"
        "        } else {\n"
        "            count\n"
        "        };",
        "        // SAFETY: `returned` is supplied by the bridge and is non-null.\n"
        "        unsafe {\n"
        "            *returned = if context.overread {\n"
        "                capacity.saturating_add(1)\n"
        "            } else {\n"
        "                count\n"
        "            };\n"
        "        }",
        2,
        "returned count write",
    )
    source = replace_exact(
        source,
        "            *returned = 0;",
        "            // SAFETY: `returned` is supplied by the bridge and is non-null.\n"
        "            unsafe { *returned = 0 };",
        1,
        "early EOF write",
    )

    SOURCE.write_text(source, encoding="utf-8")
    print("made data-plane FFI test callbacks explicit under Rust 2024")


if __name__ == "__main__":
    main()
