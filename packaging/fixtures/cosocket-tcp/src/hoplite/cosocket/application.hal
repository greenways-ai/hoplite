(ns hoplite.cosocket.application
  (:require [hoplite.core :as h]
            [hoplite.socket :as socket]
            [std.foundation.string :as string]))

(defn failure-response
  [stage result]
  {:status 502
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite-cosocket-stage" stage}
   :body (str stage ": " (get result 1) "\n")})

(defn ^:async echo
  [request]
  (let [host (get (get request :headers) "x-cosocket-host")]
    (if
     (nil? host)
     {:status 400
      :headers {"content-type" "text/plain; charset=utf-8"}
      :body "x-cosocket-host is required\n"}
     (let [client
           (std.foundation.coroutine/await
            (socket/tcp))
           configured
           (std.foundation.coroutine/await
            (socket/settimeouts client 1000 1000 1000))
           connected
           (std.foundation.coroutine/await
            (socket/connect client host 19091))]
       (if
        (get connected 1)
        (do
          (std.foundation.coroutine/await (socket/close client))
          (failure-response "connect" connected))
        (let [sent
              (std.foundation.coroutine/await
               (socket/send client "ping\n"))]
          (if
           (get sent 1)
           (do
             (std.foundation.coroutine/await (socket/close client))
             (failure-response "send" sent))
           (let [received
                 (std.foundation.coroutine/await
                  (socket/receive client "*l"))]
             (std.foundation.coroutine/await (socket/close client))
             (if
              (get received 1)
              (failure-response "receive" received)
              {:status 200
               :headers {"content-type" "application/octet-stream"
                         "x-hoplite-cosocket" "tcp-event-loop"}
               :body (get received 0)})))))))))

(defn ^:async unix-echo
  [_request]
  (let [client
        (std.foundation.coroutine/await
         (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client "unix:/cosocket/echo.sock"))]
    (if
     (get connected 1)
     (do
       (std.foundation.coroutine/await (socket/close client))
       (failure-response "unix-connect" connected))
     (let [sent
           (std.foundation.coroutine/await
            (socket/send client "unix\n"))]
       (if
        (get sent 1)
        (do
          (std.foundation.coroutine/await (socket/close client))
          (failure-response "unix-send" sent))
        (let [received
              (std.foundation.coroutine/await
               (socket/receive client "*l"))]
          (std.foundation.coroutine/await (socket/close client))
          (if
           (get received 1)
           (failure-response "unix-receive" received)
           {:status 200
            :headers {"content-type" "application/octet-stream"
                      "x-hoplite-cosocket" "tcp-unix-domain"}
            :body (get received 0)})))))))

(defn ^:async dns-echo
  [_request]
  (let [client
        (std.foundation.coroutine/await
         (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client "cosocket-echo.test" 19091))]
    (if
     (get connected 1)
     (do
       (std.foundation.coroutine/await (socket/close client))
       (failure-response "dns-connect" connected))
     (let [sent
           (std.foundation.coroutine/await
            (socket/send client "dns\n"))
           received
           (if
            (get sent 1)
            [nil (get sent 1) nil]
            (std.foundation.coroutine/await
             (socket/receive client "*l")))]
       (std.foundation.coroutine/await (socket/close client))
       (if
        (get sent 1)
        (failure-response "dns-send" sent)
        (if
         (get received 1)
         (failure-response "dns-receive" received)
         {:status 200
          :headers {"content-type" "application/octet-stream"
                    "x-hoplite-cosocket" "tcp-nginx-resolver"}
          :body (get received 0)}))))))

(defn ^:async dns-result
  [request]
  (let [host
        (or
         (get (get request :headers) "x-cosocket-name")
         "missing.cosocket.test")
        client
        (std.foundation.coroutine/await
         (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client host 19091))]
    (std.foundation.coroutine/await (socket/close client))
    {:status 200
     :headers {"content-type" "text/plain; charset=utf-8"
               "x-hoplite-cosocket" "tcp-nginx-resolver-error"}
     :body (or (get connected 1) "connected")}))

(defn ^:async receive-any
  [request]
  (let [host (get (get request :headers) "x-cosocket-host")
        client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client host 19091))
        sent
        (std.foundation.coroutine/await
         (socket/send client "receiveany\n"))
        received
        (std.foundation.coroutine/await
         (socket/receiveany client 4))]
    (std.foundation.coroutine/await (socket/close client))
    (if
     (get received 1)
     (failure-response "receiveany" received)
     {:status 200
      :headers {"content-type" "application/octet-stream"
                "x-hoplite-cosocket" "tcp-receiveany"}
      :body (get received 0)})))

(defn ^:async receive-until
  [request]
  (let [host (get (get request :headers) "x-cosocket-host")
        client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client host 19091))
        sent
        (std.foundation.coroutine/await
         (socket/send client "receiveuntil\n"))
        reader
        (std.foundation.coroutine/await
         (socket/receiveuntil client "--boundary--"))
        first (std.foundation.coroutine/await (reader))
        second (std.foundation.coroutine/await (reader))
        tail
        (std.foundation.coroutine/await
         (socket/receiveany client 5))]
    (std.foundation.coroutine/await (socket/close client))
    (cond
     (get first 1) (failure-response "receiveuntil-first" first)
     (get second 1) (failure-response "receiveuntil-second" second)
     (get tail 1) (failure-response "receiveuntil-tail" tail)
     :else
     {:status 200
      :headers {"content-type" "application/octet-stream"
                "x-hoplite-cosocket" "tcp-receiveuntil"}
      :body
      (str
       (string/decode-utf8 (get first 0))
       "|"
       (string/decode-utf8 (get second 0))
       "|"
       (string/decode-utf8 (get tail 0)))})))

(defn ^:async receive-until-inclusive
  [request]
  (let [host (get (get request :headers) "x-cosocket-host")
        client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client host 19091))
        sent
        (std.foundation.coroutine/await
         (socket/send client "receiveuntil-inclusive\n"))
        reader
        (std.foundation.coroutine/await
         (socket/receiveuntil
          client
          "--boundary--"
          {:inclusive true}))
        first (std.foundation.coroutine/await (reader))
        tail
        (std.foundation.coroutine/await
         (socket/receiveany client 5))]
    (std.foundation.coroutine/await (socket/close client))
    (cond
     (get first 1) (failure-response "receiveuntil-inclusive" first)
     (get tail 1) (failure-response "receiveuntil-inclusive-tail" tail)
     :else
     {:status 200
      :headers {"content-type" "application/octet-stream"
                "x-hoplite-cosocket" "tcp-receiveuntil-inclusive"}
      :body
      (str
       (string/decode-utf8 (get first 0))
       "|"
       (string/decode-utf8 (get tail 0)))})))

(defn ^:async receive-until-chunked
  [request]
  (let [host (get (get request :headers) "x-cosocket-host")
        client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client host 19091))
        sent
        (std.foundation.coroutine/await
         (socket/send client "receiveuntil-chunked\n"))
        reader
        (std.foundation.coroutine/await
         (socket/receiveuntil client "--boundary--"))
        first (std.foundation.coroutine/await (reader 3))
        second (std.foundation.coroutine/await (reader 3))
        done (std.foundation.coroutine/await (reader 3))
        tail
        (std.foundation.coroutine/await
         (socket/receiveany client 4))]
    (std.foundation.coroutine/await (socket/close client))
    (cond
     (get first 1) (failure-response "receiveuntil-chunk-first" first)
     (get second 1) (failure-response "receiveuntil-chunk-second" second)
     (get done 1) (failure-response "receiveuntil-chunk-done" done)
     (get tail 1) (failure-response "receiveuntil-chunk-tail" tail)
     :else
     {:status 200
      :headers {"content-type" "application/octet-stream"
                "x-hoplite-cosocket" "tcp-receiveuntil-chunked"}
      :body
      (str
       (string/decode-utf8 (get first 0))
       "|"
       (string/decode-utf8 (get second 0))
       "|"
       (nil? (get done 0))
       "|"
       (string/decode-utf8 (get tail 0)))})))

(defn ^:async set-options
  [request]
  (let [host (get (get request :headers) "x-cosocket-host")
        client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client host 19091))
        keepalive
        (std.foundation.coroutine/await
         (socket/setoption client "keepalive" true))
        reuseaddr
        (std.foundation.coroutine/await
         (socket/setoption client "reuseaddr" 1))
        nodelay
        (std.foundation.coroutine/await
         (socket/setoption client "tcp-nodelay" true))
        sndbuf
        (std.foundation.coroutine/await
         (socket/setoption client "sndbuf" 32768))
        rcvbuf
        (std.foundation.coroutine/await
         (socket/setoption client "rcvbuf" 32768))
        sent
        (std.foundation.coroutine/await
         (socket/send client "setoption\n"))
        received
        (std.foundation.coroutine/await
         (socket/receive client "*l"))]
    (std.foundation.coroutine/await (socket/close client))
    (cond
     (get connected 1) (failure-response "setoption-connect" connected)
     (get keepalive 1) (failure-response "setoption-keepalive" keepalive)
     (get reuseaddr 1) (failure-response "setoption-reuseaddr" reuseaddr)
     (get nodelay 1) (failure-response "setoption-tcp-nodelay" nodelay)
     (get sndbuf 1) (failure-response "setoption-sndbuf" sndbuf)
     (get rcvbuf 1) (failure-response "setoption-rcvbuf" rcvbuf)
     (get sent 1) (failure-response "setoption-send" sent)
     (get received 1) (failure-response "setoption-receive" received)
     :else
     {:status 200
      :headers {"content-type" "application/octet-stream"
                "x-hoplite-cosocket" "tcp-setoption"}
      :body (get received 0)})))

(defn ^:async shutdown-send
  [request]
  (let [host (get (get request :headers) "x-cosocket-host")
        client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client host 19091))
        sent
        (std.foundation.coroutine/await
         (socket/send client "shutdown-send\n"))
        stopped
        (std.foundation.coroutine/await
         (socket/shutdown client "send"))
        rejected
        (std.foundation.coroutine/await
         (socket/send client "must-not-send"))
        received
        (std.foundation.coroutine/await
         (socket/receive client "*l"))]
    (std.foundation.coroutine/await (socket/close client))
    (cond
     (get connected 1) (failure-response "shutdown-connect" connected)
     (get sent 1) (failure-response "shutdown-send" sent)
     (get stopped 1) (failure-response "shutdown" stopped)
     (not (= "closed" (get rejected 1)))
     (failure-response "send-after-shutdown" rejected)
     (get received 1) (failure-response "receive-after-shutdown" received)
     :else
     {:status 200
      :headers {"content-type" "application/octet-stream"
                "x-hoplite-cosocket" "tcp-shutdown-send"}
      :body (get received 0)})))

(defn ^:async keepalive-echo
  [request]
  (let [headers (get request :headers)
        host (get headers "x-cosocket-host")
        pool-name (or (get headers "x-cosocket-pool") "fixture")
        idle-timeout (if (= "short" (get headers "x-cosocket-idle")) 100 5000)
        client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect
          client host 19091
          {:pool pool-name :pool-size 2 :backlog 0}))]
    (if
     (get connected 1)
     (do
       (std.foundation.coroutine/await (socket/close client))
       (failure-response "keepalive-connect" connected))
     (let [reused
           (std.foundation.coroutine/await
            (socket/getreusedtimes client))]
       (if
        (get reused 1)
        (do
          (std.foundation.coroutine/await (socket/close client))
          (failure-response "keepalive-reused" reused))
        (let [sent
              (std.foundation.coroutine/await
               (socket/send client "keepalive\n"))]
          (if
           (get sent 1)
           (do
             (std.foundation.coroutine/await (socket/close client))
             (failure-response "keepalive-send" sent))
           (let [received
                 (std.foundation.coroutine/await
                  (socket/receive client "*l"))]
             (if
              (get received 1)
              (do
                (std.foundation.coroutine/await (socket/close client))
                (failure-response "keepalive-receive" received))
              (let [returned
                    (std.foundation.coroutine/await
                     (socket/setkeepalive client idle-timeout 2))]
                (if
                 (get returned 1)
                 (do
                   (std.foundation.coroutine/await (socket/close client))
                   (failure-response "setkeepalive" returned))
                 {:status 200
                  :headers {"content-type" "text/plain; charset=utf-8"
                            "x-hoplite-cosocket" "tcp-keepalive-pool"}
                  :body
                  (str
                   (string/decode-utf8 (get received 0))
                   "|"
                   (get reused 0))})))))))))))

(defn ^:async keepalive-unix
  [_request]
  (let [client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect client "unix:/cosocket/echo.sock"))]
    (if
     (get connected 1)
     (do
       (std.foundation.coroutine/await (socket/close client))
       (failure-response "keepalive-unix-connect" connected))
     (let [reused
           (std.foundation.coroutine/await
            (socket/getreusedtimes client))
           sent
           (std.foundation.coroutine/await
            (socket/send client "keepalive\n"))
           received
           (std.foundation.coroutine/await
            (socket/receive client "*l"))]
       (cond
        (get reused 1)
        (do
          (std.foundation.coroutine/await (socket/close client))
          (failure-response "keepalive-unix-reused" reused))
        (get sent 1)
        (do
          (std.foundation.coroutine/await (socket/close client))
          (failure-response "keepalive-unix-send" sent))
        (get received 1)
        (do
          (std.foundation.coroutine/await (socket/close client))
          (failure-response "keepalive-unix-receive" received))
        :else
        (let [returned
              (std.foundation.coroutine/await
               (socket/setkeepalive client 5000 2))]
          (if
           (get returned 1)
           (do
             (std.foundation.coroutine/await (socket/close client))
             (failure-response "keepalive-unix-return" returned))
           {:status 200
            :headers {"content-type" "text/plain; charset=utf-8"
                      "x-hoplite-cosocket" "unix-keepalive-pool"}
            :body
            (str
             (string/decode-utf8 (get received 0))
             "|"
             (get reused 0))})))))))

(defn ^:async keepalive-dirty
  [request]
  (let [host (get (get request :headers) "x-cosocket-host")
        client (std.foundation.coroutine/await (socket/tcp))
        configured
        (std.foundation.coroutine/await
         (socket/settimeouts client 1000 1000 1000))
        connected
        (std.foundation.coroutine/await
         (socket/connect
          client host 19091
          {:pool "dirty-fixture" :pool-size 2 :backlog 0}))]
    (if
     (get connected 1)
     (do
       (std.foundation.coroutine/await (socket/close client))
       (failure-response "dirty-connect" connected))
     (let [sent
           (std.foundation.coroutine/await
            (socket/send client "keepalive-dirty\n"))
           received
           (std.foundation.coroutine/await
            (socket/receive client "*l"))
           returned
           (std.foundation.coroutine/await
            (socket/setkeepalive client 5000 2))]
       (std.foundation.coroutine/await (socket/close client))
       (cond
        (get sent 1) (failure-response "dirty-send" sent)
        (get received 1) (failure-response "dirty-receive" received)
        :else
        {:status 200
         :headers {"content-type" "text/plain; charset=utf-8"
                   "x-hoplite-cosocket" "tcp-keepalive-dirty"}
         :body (or (get returned 1) "pooled")})))))

(def app
  (h/app
   {:name "cosocket-tcp"
    :resources
    [["/cosocket/echo"
      {:get {:name "cosocket-tcp-echo"
             :summary "Connects, writes and reads through an evented TCP cosocket"
             :handler #'echo}}]
     ["/cosocket/unix"
      {:get {:name "cosocket-unix-domain-echo"
             :summary "Connects through a Unix-domain stream cosocket"
             :handler #'unix-echo}}]
     ["/cosocket/dns"
      {:get {:name "cosocket-nginx-resolver-echo"
             :summary "Resolves a hostname through the configured Nginx resolver"
             :handler #'dns-echo}}]
     ["/cosocket/dns-result"
      {:get {:name "cosocket-nginx-resolver-result"
             :summary "Returns one ordinary DNS or resolver configuration result"
             :handler #'dns-result}}]
     ["/cosocket/receiveany"
      {:get {:name "cosocket-tcp-receiveany"
             :summary "Returns available bytes without waiting for the maximum"
             :handler #'receive-any}}]
     ["/cosocket/receiveuntil"
      {:get {:name "cosocket-tcp-receiveuntil"
             :summary "Reads repeated split delimiters and preserves the suffix"
             :handler #'receive-until}}]
     ["/cosocket/receiveuntil-inclusive"
      {:get {:name "cosocket-tcp-receiveuntil-inclusive"
             :summary "Includes a split delimiter in the returned data"
             :handler #'receive-until-inclusive}}]
     ["/cosocket/receiveuntil-chunked"
      {:get {:name "cosocket-tcp-receiveuntil-chunked"
             :summary "Iterates in bounded chunks until the delimiter"
             :handler #'receive-until-chunked}}]
     ["/cosocket/setoption"
      {:get {:name "cosocket-tcp-setoption"
             :summary "Applies the bounded OpenResty TCP socket options"
             :handler #'set-options}}]
     ["/cosocket/shutdown-send"
      {:get {:name "cosocket-tcp-shutdown-send"
             :summary "Half-closes the send direction and receives the peer reply"
             :handler #'shutdown-send}}]
     ["/cosocket/keepalive"
      {:get {:name "cosocket-tcp-keepalive"
             :summary "Returns and reuses a clean worker-local TCP connection"
             :handler #'keepalive-echo}}]
     ["/cosocket/keepalive-unix"
      {:get {:name "cosocket-unix-keepalive"
             :summary "Returns and reuses a clean worker-local Unix connection"
             :handler #'keepalive-unix}}]
     ["/cosocket/keepalive-dirty"
      {:get {:name "cosocket-tcp-keepalive-dirty"
             :summary "Rejects a connection with unread protocol residue"
             :handler #'keepalive-dirty}}]]}))
