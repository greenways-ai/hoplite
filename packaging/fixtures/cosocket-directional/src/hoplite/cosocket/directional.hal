(ns hoplite.cosocket.directional
  (:require [hoplite.core :as h]
            [hoplite.socket :as HopliteSocket]))

(defn failure-response
  [stage result]
  {:status 502
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite-cosocket-stage" stage}
   :body (str stage ": " (get result 1))})

(defn ok-response
  [identity body]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite-cosocket" identity}
   :body body})

(defn request-host
  [request]
  (get (get request :headers) "x-cosocket-host"))

(defn ^:async echo
  [request]
  (let [client
        (Coroutine/await (HopliteSocket/tcp))
        configured
        (Coroutine/await
         (HopliteSocket/settimeouts client 2000 2000 2000))
        connected
        (Coroutine/await
         (HopliteSocket/connect client (request-host request) 19091))]
    (if
     (get connected 1)
     (do
       (Coroutine/await (HopliteSocket/close client))
       (failure-response "echo-connect" connected))
     (let [sent
           (Coroutine/await
            (HopliteSocket/send client "concurrent\n"))
           received
           (Coroutine/await
            (HopliteSocket/receive client "*l"))]
       (Coroutine/await (HopliteSocket/close client))
       (cond
        (get sent 1) (failure-response "echo-send" sent)
        (get received 1) (failure-response "echo-receive" received)
        :else
        (ok-response
         "tcp-directional-echo"
         (String/decode-utf8 (get received 0))))))))

(defn ^:async shutdown-with-read
  [request]
  (let [client
        (Coroutine/await (HopliteSocket/tcp))
        configured
        (Coroutine/await
         (HopliteSocket/settimeouts client 2000 2000 4000))
        connected
        (Coroutine/await
         (HopliteSocket/connect client (request-host request) 19091))]
    (if
     (get connected 1)
     (do
       (Coroutine/await (HopliteSocket/close client))
       (failure-response "shutdown-connect" connected))
     (let [sent
           (Coroutine/await
            (HopliteSocket/send client "directional-shutdown\n"))
           stopped
           (Coroutine/await
            (HopliteSocket/shutdown client "send"))
           received
           (Coroutine/await
            (HopliteSocket/receive client "*l"))]
       (Coroutine/await (HopliteSocket/close client))
       (cond
        (get sent 1) (failure-response "shutdown-send" sent)
        (get stopped 1) (failure-response "shutdown" stopped)
        (get received 1) (failure-response "shutdown-receive" received)
        :else
        (ok-response
         "tcp-directional-shutdown"
         (String/decode-utf8 (get received 0))))))))

(defn ^:async close-socket
  [request]
  (let [client
        (Coroutine/await (HopliteSocket/tcp))
        configured
        (Coroutine/await
         (HopliteSocket/settimeouts client 2000 2000 2000))
        connected
        (Coroutine/await
         (HopliteSocket/connect client (request-host request) 19093))]
    (if
     (get connected 1)
     (do
       (Coroutine/await (HopliteSocket/close client))
       (failure-response "close-connect" connected))
     (let [closed
           (Coroutine/await
            (HopliteSocket/close client))]
       (if
        (get closed 1)
        (failure-response "close" closed)
        (ok-response "tcp-directional-close" (str (get closed 0))))))))

(defn ^:async abandon-pending
  [request]
  (let [client
        (Coroutine/await (HopliteSocket/tcp))
        configured
        (Coroutine/await
         (HopliteSocket/settimeouts client 2000 30000 30000))
        connected
        (Coroutine/await
         (HopliteSocket/connect client (request-host request) 19093))]
    (if
     (get connected 1)
     (do
       (Coroutine/await (HopliteSocket/close client))
       (failure-response "abandon-connect" connected))
     (Coroutine/await
      (HopliteSocket/receive client "*l")))))

(def app
  (h/app
   {:name "cosocket-directional"
    :resources
    [["/directional/echo"
      {:get {:name "cosocket-directional-echo"
             :summary "Sends then receives through one TCP cosocket"
             :handler #'echo}}]
     ["/directional/shutdown"
      {:get {:name "cosocket-directional-shutdown"
             :summary "Half-closes send before receiving the peer reply"
             :handler #'shutdown-with-read}}]
     ["/directional/close"
      {:get {:name "cosocket-directional-close"
             :summary "Closes an established TCP cosocket"
             :handler #'close-socket}}]
     ["/directional/abandon"
      {:get {:name "cosocket-directional-abandon"
             :summary "Holds a receive for client-abort and worker-exit cleanup"
             :handler #'abandon-pending}}]]}))
