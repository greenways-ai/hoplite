ARG NGINX_VERSION=1.30.4

FROM rust:1.85-bookworm AS builder
ARG NGINX_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl libpcre2-dev libssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY hoplite hoplite
COPY hara hara

RUN cargo run --quiet --manifest-path hoplite/core/Cargo.toml --locked \
      --bin hoplite-provider-lock -- \
      hoplite/packaging/providers/blob/provider-lock.json \
      hoplite/packaging/providers/blob/provider-manifest.published.json \
      --provider hoplite.blob \
      --version 0.1.1 \
      --repository greenways-ai/hoplite \
      --tag hoplite-blob-provider-v0.1.1 \
      --asset hoplite-blob-provider-0.1.1.tar.gz \
      --media-type application/gzip \
      --request hoplite.blob-request/0-alpha \
      --result hoplite.blob-result/0-alpha \
      --abi hoplite.blob-provider-ffi \
      --abi-version 1 \
      --driver filesystem \
      --driver-version 1 \
      --shell > /tmp/hoplite-provider.env \
    && . /tmp/hoplite-provider.env \
    && provider_archive="/tmp/${HOPLITE_PROVIDER_ASSET}" \
    && provider_root=/src/provider-root \
    && curl --fail --location --retry 3 \
         "https://github.com/${HOPLITE_PROVIDER_REPOSITORY}/releases/download/${HOPLITE_PROVIDER_TAG}/${HOPLITE_PROVIDER_ASSET}" \
         --output "$provider_archive" \
    && echo "${HOPLITE_PROVIDER_SHA256}  ${provider_archive}" | sha256sum --check \
    && bash hoplite/packaging/scripts/verify-blob-provider-artifact.sh \
         "$provider_archive" "sha256:${HOPLITE_PROVIDER_SHA256}" "$provider_root" \
    && package="${provider_root}/hoplite-blob-provider-${HOPLITE_PROVIDER_VERSION}" \
    && test "$(cat "${package}/SOURCE_REVISION")" = "$HOPLITE_PROVIDER_SOURCE_REVISION" \
    && test "$(cat "${package}/PACKAGE_VERSION")" = "$HOPLITE_PROVIDER_VERSION" \
    && mv "$package" /src/provider \
    && rmdir "$provider_root" \
    && cargo build \
         --manifest-path /src/provider/abi/blob-store-provider-ffi/Cargo.toml \
         --release --locked
RUN make -C hoplite/core runtime nginx-source
RUN cd "hoplite/core/target/sources/nginx-${NGINX_VERSION}" \
    && HOPLITE_RUNTIME_DIR=/src/hoplite/core/target/release \
       HOPLITE_CORE_NGINX_DIR=/src/hoplite/core/nginx \
       HOPLITE_BLOB_PROVIDER_FFI_DIR=/src/provider/abi/blob-store-provider-ffi \
       HOPLITE_BLOB_PROVIDER_LIB_DIR=/src/provider/abi/blob-store-provider-ffi/target/release \
       ./configure --prefix=/src/hoplite/core/target/nginx \
         --with-http_ssl_module --with-threads \
         --add-module=/src/hoplite/core/nginx \
         --add-module=/src/hoplite/packaging/providers/blob/nginx \
    && make -j"$(nproc)" \
    && make install
RUN strip --strip-unneeded hoplite/core/target/nginx/sbin/nginx \
    && HOPLITE_DISTRIBUTION_WORKER_ENVIRONMENT=HOPLITE_BLOB_ROOT,HOPLITE_BLOB_MAX_OBJECT_BYTES,HOPLITE_BLOB_MAX_APPEND_BYTES,HOPLITE_BLOB_MAX_SOURCE_CHUNK_BYTES,HOPLITE_BLOB_MAX_STAGING_KEY_BYTES,HOPLITE_BLOB_MAX_MEDIA_TYPE_BYTES,HOPLITE_BLOB_MAX_STAGING_ENTRIES,HOPLITE_BLOB_MAX_OBJECTS \
       cargo build --manifest-path hoplite/core/Cargo.toml --release \
         --features embedded-nginx --bin hoplite --bin hoplite-server \
    && strip --strip-unneeded \
         hoplite/core/target/release/hoplite \
         hoplite/core/target/release/hoplite-server
RUN cp -R hoplite/core/examples /app \
    && hoplite/core/target/release/hoplite serve build --mode prod /app

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libpcre2-8-0 libssl3 zlib1g \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system hoplite \
    && useradd --system --gid hoplite --home /var/lib/hoplite hoplite \
    && mkdir -p /app /var/lib/hoplite/cache /var/lib/hoplite/blob \
    && chown -R hoplite:hoplite /app /var/lib/hoplite
COPY --from=builder /src/hoplite/core/target/release/hoplite-server /usr/local/bin/hoplite-server
COPY --from=builder --chown=hoplite:hoplite /app /app
USER hoplite
ENV HOPLITE_SERVER_CACHE=/var/lib/hoplite/cache \
    HOPLITE_BLOB_ROOT=/var/lib/hoplite/blob \
    HOPLITE_WORKERS=auto
VOLUME ["/var/lib/hoplite"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD curl --fail --silent http://127.0.0.1:8080/hello >/dev/null || exit 1
ENTRYPOINT ["hoplite-server"]
CMD ["/app"]
