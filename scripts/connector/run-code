#!/usr/bin/env bash
set -euo pipefail

scope="${1:?usage: scripts/connector/run-code <runtime|contracts|website>}"

case "$scope" in
  runtime)
    bash packaging/scripts/check-hara-compatibility.sh --verify-only
    cargo fmt --manifest-path core/Cargo.toml -- --check
    cargo metadata --manifest-path core/Cargo.toml --locked --no-deps >/dev/null
    cargo test --manifest-path core/Cargo.toml --workspace --locked
    bash packaging/scripts/smoke-embedding.sh
    ;;
  contracts)
    test -s packaging/hara-revision
    bash -n \
      packaging/scripts/hara-revision.sh \
      packaging/scripts/check-hara-compatibility.sh
    bash packaging/scripts/hara-revision.sh >/dev/null
    bash packaging/scripts/verify-alpha-versioning.sh
    node packaging/scripts/validate-runtime-measurement.mjs --self-test
    set +e
    output="$(
      GITHUB_ACTIONS=true \
      HOPLITE_WORKER_RELOAD_DIAGNOSTIC_CAPTURE_ONLY=1 \
      HOPLITE_WORKER_RELOAD_DIAGNOSTIC_SELF_TEST=1 \
      bash packaging/scripts/smoke-worker-reload.sh 2>&1
    )"
    status=$?
    set -e
    printf '%s\n' "$output"
    test "$status" = 97
    grep -F 'worker-reload-phase: diagnostic-self-test' <<<"$output"
    bash packaging/scripts/verify-default-product.sh
    ;;
  website)
    git config --global url."https://github.com/".insteadOf "git+ssh://git@github.com/"
    git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/"
    git config --global --add url."https://github.com/".insteadOf "git@github.com:"
    npm --prefix website ci
    npm --prefix website run build
    ;;
  *)
    printf 'unknown connector scope: %s\n' "$scope" >&2
    exit 64
    ;;
esac
