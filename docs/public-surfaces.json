        "core/src/package_catalog.rs",
        "core/src/package_export.rs",
        "core/src/module_import.rs"
      ],
      "summary": "Packaged bounded Nchan channel declarations imported into application bytecode."
    },
    {
      "name": "hoplite.dev",
      "path": "core/lib/src/hoplite/dev.hal",
      "status": "experimental",
      "conformance": [
        "core/lib/test/hoplite/core_test.hal"
      ],
      "summary": "Development-console helpers excluded from production."
    },
    {
      "name": "hoplite.host",
      "path": "core/lib/src/hoplite/host.hal",
      "status": "experimental",
      "conformance": [
        "packaging/scripts/smoke-host-providers.sh"
      ],
      "summary": "Generic host-service calls."
    },
    {
      "name": "hoplite.internal",
      "path": "core/lib/src/hoplite/internal.hal",
      "status": "internal",
      "summary": "Implementation helpers with no compatibility promise."
    },
    {
      "name": "hoplite.raw",
      "path": "core/lib/src/hoplite/raw.hal",
      "status": "public",
      "conformance": [
        "core/lib/test/hoplite/raw_test.hal",
        "core/runtime/src/lib.rs",
        "core/nginx/ngx_http_hoplite_module.c",
        "website/src/content/docs/reference/raw-exchange.mdx"
      ],
      "summary": "Borrowed raw exchanges with bounded Nginx request fields and imperative response construction."
    },
    {
      "name": "hoplite.response-source",
      "path": "core/lib/src/hoplite/response_source.hal",
      "status": "experimental",
      "conformance": [
        "core/lib/test/hoplite/response_source_test.hal",
        "packaging/scripts/smoke-response-source.sh"
      ],
      "summary": "Bounded ranged and streaming response bodies."
