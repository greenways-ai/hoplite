    {
      "name": "hoplite.rtc",
      "path": "core/lib/src/hoplite/rtc.hal",
      "status": "experimental",
      "conformance": [
        "core/lib/test/hoplite/rtc_test.hal",
        "core/runtime/src/lib.rs"
      ],
      "summary": "Worker-local WebRTC negotiation and stream Duplex composition."
