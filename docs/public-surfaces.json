  "cli_programs": [
    {
      "name": "hoplite",
      "path": "core/src/main.rs",
      "status": "public",
      "availability": "default",
      "conformance": [
        "core/src/diagnostics.rs",
        "core/src/doctor.rs"
      ],
      "summary": "Development and control CLI."
    },
    {
      "name": "hoplite-server",
      "path": "core/src/bin/hoplite-server.rs",
      "status": "public",
      "availability": "default",
      "conformance": [
