    {
      "name": "hoplite_runtime.h",
      "path": "core/nginx/hoplite_runtime.h",
      "status": "public",
      "symbol_inventory": "docs/native-symbols.txt",
      "conformance": [
        "core/runtime/examples/embed.rs",
        "core/runtime/examples/embed.c",
        "packaging/scripts/smoke-embedding.sh",
        "core/runtime/src/lib.rs",
        "core/nginx/ngx_http_hoplite_module.c"
      ],
      "summary": "Runtime lifecycle, startup diagnostics, handlers, work and versioned request embedding ABI, including bounded raw fields."
    }
