{
  "name": "@greenways/hoplite-docs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "npm run verify:surfaces && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/scope-pages-links.mjs && node scripts/inject-legacy-host-redirect.mjs && npm run verify:pages && npm run verify:og",
    "verify:surfaces": "node scripts/verify-product-surfaces.mjs && node scripts/verify-cosocket-compatibility.mjs",
    "verify:pages": "node scripts/verify-pages-output.mjs && node scripts/verify-homepage-layout.mjs",
    "verify:og": "node scripts/verify-social-preview.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/starlight": "^0.41.6",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/manrope": "^5.2.7",
    "@fontsource/marcellus": "^5.2.6",
    "@greenways-ai/visual-language": "github:greenways-ai/visual-language#9db783f0863eb72c1b91c83ab262fbfb49307982",
    "astro": "^7.1.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.2"
  }
}
