---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const artworkBase = "https://oss.greenways.ai/visual-language/artwork/hoplite/";
---

<section class="hoplite-hero">
  <div class="hoplite-hero__copy">
    <p class="technical-kicker"><i></i> Nginx + Hara · one application server</p>
    <h1>Your application, directly inside Nginx.</h1>
    <p>
      Hoplite packages Hara routes, authentication, service management, and deployment
      into one refined server. Choose a target below and bring a real endpoint online.
    </p>
    <div class="hero-links">
      <a class="action action--primary" href="#launch">Launch the starter <span>→</span></a>
      <a class="action" href="#performance">See measured speed</a>
      <a class="action" href={`${base}getting-started/`}>Documentation</a>
      <a class="action" href="https://github.com/greenways-ai/hoplite">Source ↗</a>
    </div>
    <dl class="hero-facts">
      <div><dt>Runtime</dt><dd>Nginx + embedded Hara</dd></div>
      <div><dt>Artifact</dt><dd>Executable or OCI image</dd></div>
      <div><dt>Platforms</dt><dd>macOS and Linux</dd></div>
    </dl>
  </div>

  <aside class="hoplite-hero__accent">
    <ThemedArtwork
      class="hoplite-hero__art"
      light={`${artworkBase}rabbit-courtyard-day.webp`}
      dark={`${artworkBase}rabbit-courtyard-night.webp`}
      lightMobile={`${artworkBase}rabbit-courtyard-day-mobile.webp`}
      darkMobile={`${artworkBase}rabbit-courtyard-night-mobile.webp`}
      lightAlt="A rabbit in a formal mosaic courtyard, used as a restrained Hoplite accent"
      darkAlt="A rabbit resting in a moonlit mosaic courtyard, used as a restrained Hoplite accent"
      position="center"
    />
  </aside>
</section>
