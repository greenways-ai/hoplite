---
import {
  stackFootprints as footprints,
  type Measurement,
} from "../lib/benchmark-data";

const measured = footprints.status === "measured";
const size = (value: Measurement, digits = 1) => {
  if (value == null) return "—";
  if (value > 0 && value < 0.01) return "<0.01 MiB";
  return `${value.toLocaleString("en-US", { minimumFractionDigits: digits, maximumFractionDigits: digits })} MiB`;
};
const stacks = [
  {
    key: "hoplite",
    name: "Hoplite server",
    className: "stack-card stack-card--hoplite",
    shape: "Nginx + worker-local Hara runtime",
    services: "1 service surface",
    artifactLabel: "hoplite-server executable",
    included: "Routing and prepared Hara handlers in the Nginx lifecycle",
    tradeoff: "Pre-1.0 interfaces; the alpha HBC/HBX contracts may still change",
  },
  {
    key: "java",
    name: "Nginx + JDK sample",
    className: "stack-card",
    shape: "Plain Nginx + JDK built-in HttpServer",
    services: "2 service surfaces",
    artifactLabel: "Sample JAR",
    included: "A minimal JDK runtime deployment envelope",
    tradeoff: "This is not a Ring, Spring, Quarkus, or Micronaut benchmark",
  },
  {
    key: "python",
    name: "Nginx + Python stdlib sample",
    className: "stack-card",
    shape: "Plain Nginx + ThreadingHTTPServer",
    services: "2 service surfaces",
    artifactLabel: "Sample source",
    included: "A minimal Python standard-library deployment envelope",
    tradeoff: "This is not a FastAPI, Flask, or Django benchmark",
  },
  {
    key: "lua",
    name: "Nginx + ngx_http_lua sample",
    className: "stack-card",
    shape: "Debian Nginx + ngx_http_lua module",
    services: "1 service surface",
    artifactLabel: "Nginx executable",
    included: "A minimal in-process Lua response path",
    tradeoff: "This is not the complete OpenResty distribution",
  },
] as const;
---
<section class="home-section stack-comparison">
  <header>
    <p class="technical-kicker">03 · Deployment footprint</p>
    <h2>What each stack occupies.</h2>
    <p>
      These are minimal deployment samples returning the same validated 19-byte
      response. They compare process and image shapes, not feature-equivalent web frameworks.
    </p>
  </header>

  <div class="stack-grid" data-footprint-status={footprints.status}>
    {stacks.map((stack) => {
      const footprint = footprints.stacks[stack.key];
      return (
        <article class={stack.className}>
          <h3>{stack.name}</h3>
          <div class="stack-measurements">
            <div>
              <small>Deploy image</small>
              <strong>{size(footprint.deploymentImageMiB)}</strong>
            </div>
            <div>
              <small>Idle memory</small>
              <strong>{size(footprint.idleMemoryMiB)}</strong>
            </div>
          </div>
          <dl>
            <div><dt>Measured shape</dt><dd>{stack.shape}</dd></div>
            <div><dt>Service surfaces</dt><dd>{stack.services}</dd></div>
            <div><dt>{stack.artifactLabel}</dt><dd>{size(footprint.primaryArtifactMiB, 2)}</dd></div>
            <div><dt>What it represents</dt><dd>{stack.included}</dd></div>
            <div><dt>Interpretation limit</dt><dd>{stack.tradeoff}</dd></div>
          </dl>
        </article>
      );
    })}
  </div>

  <div class="footprint-method">
    <p>
      {measured
        ? `Measured on ${footprints.runner} with ${footprints.logicalCpus} logical CPUs. Idle memory is the median of ${footprints.methodology.idleSamplesPerComponent} samples per component.`
        : "Fresh post-split deployment measurements are pending; retired all-in-one values are not displayed."}
    </p>
    <p>{footprints.methodology.imageAccounting}</p>
    <p>{footprints.methodology.scope}</p>
  </div>

  <p class="comparison-conclusion">
    The useful question is where each minimal serving envelope places its proxy,
    runtime, application artifact, processes, and resident memory—not whether every
    application in a language has one fixed size.
  </p>
</section>
