---
import DocumentationHeader from "@greenways-ai/visual-language/DocumentationHeader.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const searchBase = base.replace(/\/$/, "");
---

<DocumentationHeader
  project="hoplite"
  title="Hoplite"
  homeHref={base}
  docsHref={`${base}getting-started/`}
  docsLabel="Docs"
  searchBase={searchBase}
  searchLabel="Search Hoplite documentation"
/>
