(ns hoplite.app
  (:require [hoplite.core :as h]))

;; This example is also the production-image conformance surface for request
;; bodies, registered host providers, persistent blob custody, and bounded
;; response-source streaming.

(def response-source-fixture-digest
  "sha256:aca1cd027e979588d14b877b7b0cb8585ad9fec599eb45801992ee5382b3760f")

(def response-source-fixture-length
  1048576)

(def response-source-fixture-staging-key
  "hoplite-response-source-fixture")

(def response-source-range-offset
  4096)

(def response-source-range-length
  65536)

(def response-source-range-header
  "bytes 4096-69631/1048576")

(defn response-source-descriptor
  [source-handle offset length]
  {:protocol "hoplite.response-source/0-alpha"
   :service "hoplite.blob"
   :source-handle source-handle
   :offset offset
   :length length})

(defn hello
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite" "true"}
   :body "Hello from Hoplite\n"})

(defn ^:async delayed
  [request]
  (std.foundation.coroutine/await
    (std.native.Host/call "nginx" "sleep" [25]))
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite" "promise-resumed"}
   :body "Hara coroutine resumed from the Nginx event loop\n"})

(defn ^:async unknown-host-service
  [request]
  (std.foundation.coroutine/await
    (std.native.Host/call "missing" "noop" []))
  {:status 200 :body "unexpected host service success\n"})

(defn ^:async unknown-host-operation
  [request]
  (std.foundation.coroutine/await
    (std.native.Host/call "nginx" "missing" []))
  {:status 200 :body "unexpected host operation success\n"})

(defn ^:async invalid-host-arguments
  [request]
  (std.foundation.coroutine/await
    (std.native.Host/call "nginx" "sleep" [-1]))
  {:status 200 :body "unexpected invalid host call success\n"})

(defn inspect
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"}
   :body "inspect"})

(defn body-handle
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"}
   :body (if (:body-handle request)
           "native-body-handle\n"
           "missing-body-handle\n")})

(defn source-response
  [opened]
  {:status 200
   :headers {"content-type" "application/octet-stream"
             ;; The Nginx host owns the authoritative descriptor length.
             "content-length" "1"
             "x-hoplite-source" "true"}
   :body
   (response-source-descriptor
    (get opened :source-handle)
    (get opened :offset)
    (get opened :length))})

(defn range-source-response
  [opened]
  {:status 206
   :headers {"content-type" "application/octet-stream"
             ;; The Nginx host replaces this with the exact source length.
             "content-length" "1"
             "content-range" response-source-range-header
             "accept-ranges" "bytes"
             "x-hoplite-source" "true"}
   :body
   (response-source-descriptor
    (get opened :source-handle)
    (get opened :offset)
    (get opened :length))})

(defn ^:async upload-response-source
  [request]
  (let [source-handle (get request :body-handle)]
    (if
     source-handle
     (do
       (std.foundation.coroutine/await
        (std.native.Host/call
         "hoplite.blob"
         "staging/open"
         [{:protocol "hoplite.blob-request/0-alpha"
           :operation "staging/open"
           :staging-key response-source-fixture-staging-key
           :expected-digest response-source-fixture-digest
           :expected-size response-source-fixture-length
           :media-type "application/octet-stream"}]))
       (std.foundation.coroutine/await
        (std.native.Host/call
         "hoplite.blob"
         "staging/append-from-source"
         [{:protocol "hoplite.blob-request/0-alpha"
           :operation "staging/append-from-source"
           :staging-key response-source-fixture-staging-key
           :offset 0
           :length response-source-fixture-length
           :source-handle source-handle}]))
       (std.foundation.coroutine/await
        (std.native.Host/call
         "hoplite.blob"
         "staging/verify-commit"
         [{:protocol "hoplite.blob-request/0-alpha"
           :operation "staging/verify-commit"
           :staging-key response-source-fixture-staging-key
           :expected-digest response-source-fixture-digest
           :expected-size response-source-fixture-length}]))
       (let [opened
             (std.foundation.coroutine/await
              (std.native.Host/call
               "hoplite.blob"
               "object/open-source"
               [{:protocol "hoplite.blob-request/0-alpha"
                 :operation "object/open-source"
                 :digest response-source-fixture-digest
                 :offset 0
                 :length response-source-fixture-length}]))]
         (source-response opened)))
     {:status 400
      :headers {"content-type" "text/plain; charset=utf-8"}
      :body "response-source fixture requires a request body\n"})))

(defn ^:async read-response-source
  [request]
  (let [opened
        (std.foundation.coroutine/await
         (std.native.Host/call
          "hoplite.blob"
          "object/open-source"
          [{:protocol "hoplite.blob-request/0-alpha"
            :operation "object/open-source"
            :digest response-source-fixture-digest
            :offset 0
            :length response-source-fixture-length}]))]
    (source-response opened)))

(defn ^:async read-response-source-range
  [request]
  (let [opened
        (std.foundation.coroutine/await
         (std.native.Host/call
          "hoplite.blob"
          "object/open-source"
          [{:protocol "hoplite.blob-request/0-alpha"
            :operation "object/open-source"
            :digest response-source-fixture-digest
            :offset response-source-range-offset
            :length response-source-range-length}]))]
    (range-source-response opened)))

(defn ^:async invalid-response-source
  [request]
  (std.foundation.coroutine/await
   (std.native.Host/call "nginx" "sleep" [1]))
  {:status 200
   :body {:protocol "hoplite.response-source/0-alpha"
          :service "hoplite.blob"
          :source-handle 1
          :offset 0
          :length 1
          :extra true}})

(defn ^:async stale-response-source
  [request]
  (std.foundation.coroutine/await
   (std.native.Host/call "nginx" "sleep" [1]))
  {:status 200
   :body (response-source-descriptor
          9007199254740991
          0
          1)})

(def app
  (h/app
    {:name "example"
     :request/body {:max-bytes 1048576
                    :max-chunk-bytes 65536}
     :resources
     [["/hello"
       {:get {:name "hello"
              :summary "A synchronous response"
              :handler #'hello}}]
      ["/delay"
       {:get {:name "delay"
              :summary "A coroutine resumed by the nginx host provider"
              :handler #'delayed}}]
      ["/host/unknown-service"
       {:get {:name "unknown-host-service"
              :summary "Rejects an unregistered host service"
              :handler #'unknown-host-service}}]
      ["/host/unknown-operation"
       {:get {:name "unknown-host-operation"
              :summary "Rejects an unsupported provider operation"
              :handler #'unknown-host-operation}}]
      ["/host/invalid-arguments"
       {:get {:name "invalid-host-arguments"
              :summary "Rejects malformed provider arguments"
              :handler #'invalid-host-arguments}}]
      ["/inspect"
       {:get {:name "inspect"
              :handler #'inspect}}]
      ["/body-handle"
       {:post {:name "body-handle"
               :summary "Projects an opaque native body handle"
               :handler #'body-handle}}]
      ["/response-source"
       {:post {:name "response-source-upload"
               :summary "Uploads and streams one immutable source"
               :handler #'upload-response-source}
        :get {:name "response-source-read"
              :summary "Streams the installed immutable source"
              :handler #'read-response-source}
        :head {:name "response-source-head"
               :summary "Closes a source without reading its body"
               :handler #'read-response-source}}]
      ["/response-source/range"
       {:get {:name "response-source-range-read"
              :summary "Streams a non-zero immutable source range"
              :handler #'read-response-source-range}
        :head {:name "response-source-range-head"
               :summary "Closes a ranged source without reading its body"
               :handler #'read-response-source-range}}]
      ["/response-source/invalid"
       {:get {:name "response-source-invalid"
              :summary "Rejects a descriptor with additional authority"
              :handler #'invalid-response-source}}]
      ["/response-source/stale"
       {:get {:name "response-source-stale"
              :summary "Rejects an unowned opaque source handle"
              :handler #'stale-response-source}}]]}))
