(ns hoplite.app
  (:require [hoplite.core :as h]))

;; This example is also the production-image conformance surface for the
;; request-body V3 adapter and its bounded native body-handle route.

(defn hello
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite" "true"}
   :body "Hello from Hoplite\n"})

(defn ^:async delayed
  [request]
  (std.foundation.coroutine/await
    (std.native.Host/call "nginx" "sleep" [25]))
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite" "promise-resumed"}
   :body "Hara coroutine resumed from the Nginx event loop\n"})

(defn inspect
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"}
   :body "inspect"})

(defn body-handle
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"}
   :body (if (:body-handle request)
           "native-body-handle\n"
           "missing-body-handle\n")})

(def app
  (h/app
    {:name "example"
     :request/body {:max-bytes 32
                    :max-chunk-bytes 8}
     :resources
     [["/hello"
       {:get {:name "hello"
              :summary "A synchronous response"
              :handler #'hello}}]
      ["/delay"
       {:get {:name "delay"
              :summary "A coroutine resumed by nginx"
              :handler #'delayed}}]
      ["/inspect"
       {:get {:name "inspect"
              :handler #'inspect}}]
      ["/body-handle"
       {:post {:name "body-handle"
               :summary "Projects an opaque native body handle"
               :handler #'body-handle}}]]}))
