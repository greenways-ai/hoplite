(ns hoplite.value-test
  (:require [std.lib.test :as test]
            [hoplite.value :as canonical]))

(def digest-a
  "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")

(def digest-b
  "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")

(def request
  (canonical/verification-request digest-a 1024))

(def success
  (canonical/verified-result
   digest-a
   48
   {:name "tree"
    :version 1
    :visible true
    :children [nil :leaf 2.5]
    :payload (bytes 0 1 -1)}))

(def failure
  (canonical/failed-result
   digest-a
   "hoplite.value/hta-noncanonical"))

(test/print-results
 [(test/check
   "constructs one closed application-neutral verification request"
   request
   {:protocol "hoplite.value-request/0-alpha"
    :operation "object/verify-hta"
    :digest digest-a
    :max-bytes 1024})

  (test/check
   "constructs closed verified and failed result variants"
   [(canonical/success-result? success)
    (canonical/failure-result? failure)
    (canonical/result? success)
    (canonical/result? failure)]
   [true true true true])

  (test/check
   "requests bind one exact digest and mandatory bounded maximum"
   [(canonical/request? request)
    (canonical/request? (assoc request :path "/tmp/value"))
    (canonical/request? (assoc request :digest "sha256:bad"))
    (canonical/request? (assoc request :operation "manifest/verify"))
    (canonical/request? (assoc request :max-bytes 0))
    (canonical/request?
     (assoc request :max-bytes (inc canonical/max-frame-bytes)))
    (canonical/request?
     (canonical/verification-request
      digest-a
      canonical/max-frame-bytes))]
   [true false false false false false true])

  (test/check
   "success results accept only recursively portable ordinary values"
   [(canonical/portable-value? nil)
    (canonical/portable-value? false)
    (canonical/portable-value? 1)
    (canonical/portable-value? 2.5)
    (canonical/portable-value? "value")
    (canonical/portable-value? :value)
    (canonical/portable-value? (bytes 0 1 -1))
    (canonical/portable-value? [1 {:value true}])
    (canonical/portable-value? '(1 2))
    (canonical/portable-value? #{1 2})
    (canonical/portable-value? 'value)
    (canonical/portable-value? {:value inc})
    (canonical/success-result? (assoc success :provider "memory"))]
   [true true true true true true true true false false false false false])

  (test/check
   "failure results expose only stable generic codes"
   [(canonical/failure-result? failure)
    (canonical/failure-result?
     (assoc failure :code "sqlite/read-failed"))
    (canonical/failure-result?
     (assoc failure :path "/srv/objects/value"))
    (canonical/failure-result?
     (assoc failure :verified true))]
   [true false false false])

  (test/check
   "results match the originating digest and maximum exactly"
   [(canonical/result-matches-request? request success)
    (canonical/result-matches-request? request failure)
    (canonical/result-matches-request?
     request
     (assoc success :digest digest-b))
    (canonical/result-matches-request?
     request
     (assoc success :byte-length 1025))
    (canonical/result-matches-request?
     (assoc request :digest digest-b)
     failure)]
   [true true false false false])

  (test/check
   "invalid constructors fail through one stable contract boundary"
   [(try
      (canonical/verification-request digest-a 0)
      (catch Throwable error
        (ex-data error)))
    (try
      (canonical/verified-result digest-a 1 inc)
      (catch Throwable error
        (ex-data error)))
    (try
      (canonical/failed-result digest-a "sqlite/error")
      (catch Throwable error
        (ex-data error)))]
   [{:phase :canonical-value/invalid :reason :request}
    {:phase :canonical-value/invalid :reason :success-result}
    {:phase :canonical-value/invalid :reason :failure-result}])

  (test/check
   "portable requests contain no installation or source authority"
   [(get request :protocol)
    (get request :operation)
    (has? request :provider)
    (has? request :driver)
    (has? request :path)
    (has? request :url)
    (has? request :credentials)
    (has? request :source-handle)]
   ["hoplite.value-request/0-alpha"
    "object/verify-hta"
    false false false false false false])])
