(ns hoplite.core-test
  (:require [hoplite.core :as h]
            [hoplite.internal :as internal]))

(defn sample-handler [_request]
  {:status 200 :body "ok"})

(def checks
  [(= :application (:hoplite/type (h/app {:resources []})))
   (= #'sample-handler (:handler (h/app #'sample-handler)))
   (= {:hoplite/type :response :status 200 :body "ok"}
      (h/response 200 "ok"))
   (= :stream (:hoplite/type (h/stream ["a" "b"])))
   (= :middleware (:hoplite/type (h/middleware {:request identity})))
   (= :service (:hoplite/type (h/service {:start #'sample-handler})))
   (= :module (:hoplite/type (h/module {:module/export :hoplite/auth})))
   (= :adapter (:hoplite/type (h/adapter {:adapter/for :hoplite/store})))
   (= :store (:hoplite/type (h/store {:store/operations {}})))
   (= {:hoplite/type :package-ref
       :module/id "gh:greenways-ai:hoplite"
       :module/version "0.1.0"
       :module/export :hoplite/auth
       :module/as :auth
       :module/config {}}
      (h/package-ref "gh:greenways-ai:hoplite"
                     "0.1.0"
                     :hoplite/auth
                     :auth
                     {}))
   (= :config (:hoplite/type (internal/config {:apps []})))])

(if (every? identity checks)
  true
  (throw "hoplite.core tests failed"))
