(ns hoplite.socket-test
  (:config {})
  (:require [hoplite.socket :as socket]))

(def tcp-socket
  {:hoplite/type :socket
   :protocol "hoplite.socket/0-alpha"
   :kind :tcp
   :handle 17})

^{:refer hoplite.socket/socket?}
(Test/check
 [{:name "accepts only complete TCP socket descriptors"
   :test (fn []
           [(socket/socket? tcp-socket)
            (socket/socket? nil)
            (socket/socket? {})
            (socket/socket? {:hoplite/type :socket
                             :protocol "hoplite.socket/0-alpha"
                             :kind :udp
                             :handle 17})
            (socket/socket? {:hoplite/type :socket
                             :protocol "hoplite.socket/0-alpha"
                             :kind :tcp
                             :handle 0})])
   :expected [true false false false false]}
  {:name "recognizes validated TCP descriptors"
   :test (fn [] (socket/tcp? tcp-socket))
   :expected true}
  {:name "returns the validated descriptor kind"
   :test (fn [] (socket/socket-kind tcp-socket))
   :expected :tcp}
  {:name "returns the original validated descriptor"
   :test (fn [] (socket/require-socket tcp-socket))
   :expected tcp-socket}])
