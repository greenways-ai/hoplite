(ns hoplite.socket
  (:config {}))

(def protocol
  "hoplite.socket/0-alpha")

(defn socket?
  "Returns true for one request-scoped Hoplite socket descriptor."
  [value]
  (and
   (map? value)
   (= 4 (count value))
   (= :socket (get value :hoplite/type))
   (= protocol (get value :protocol))
   (= :tcp (get value :kind))
   (integer? (get value :handle))
   (> (get value :handle) 0)))

(defn tcp?
  [value]
  (and (socket? value)
       (= :tcp (get value :kind))))

(defn- invalid-socket
  [value]
  (throw
   (ex :hoplite.ex/invalid-socket {:phase :socket/invalid-descriptor
     :value value} :ex/message "invalid hoplite.socket/0-alpha descriptor" :ex/class :hoplite.class/socket)))

(defn require-socket
  "Returns a validated socket descriptor or throws a structured error."
  [value]
  (if (socket? value)
    value
    (invalid-socket value)))

(defn socket-kind
  [socket]
  (get (require-socket socket) :kind))

(defn- socket-handle
  [socket]
  (get (require-socket socket) :handle))

(defn- socket-value
  [kind handle]
  (require-socket
   {:hoplite/type :socket
    :protocol protocol
    :kind kind
    :handle handle}))

(defn- host-call
  [operation arguments]
  (std.native.Host/call "hoplite.socket" operation arguments))

(defn ^:async tcp
  "Creates one request-scoped TCP cosocket.

  The returned descriptor is opaque authority only inside its owning request
  and worker. The numeric handle cannot be transferred or persisted."
  []
  (socket-value
   :tcp
   (std.foundation.coroutine/await
    (host-call "tcp" []))))

(defn ^:async connect
  "Connects a TCP cosocket to a numeric IPv4/IPv6 address or hostname and port,
  or to one explicit Unix-domain target of the form unix:/absolute/path.
  Hostnames use the configured nonblocking Nginx resolver and remain bounded by
  the connect and resolver timeouts. The options map accepts :pool and
  :pool-size; :backlog must remain zero until the bounded backlog slice lands.
  Returns [1 nil] or [nil error], matching OpenResty's ordinary cosocket result
  convention."
  ([socket target]
   (std.foundation.coroutine/await
    (host-call
     "connect"
     [(socket-handle socket) target])))
  ([socket host port]
   (connect socket host port {}))
  ([socket host port options]
   (std.foundation.coroutine/await
    (host-call
     "connect"
     [(socket-handle socket) host port options]))))

(defn ^:async send
  "Sends one string or byte value. Returns [bytes-sent nil] or [nil error]."
  [socket value]
  (std.foundation.coroutine/await
   (host-call "send" [(socket-handle socket) value])))

(defn ^:async receive
  "Receives a fixed positive byte count, one line with *l, or all remaining
  bytes with *a. Returns [data nil nil] or [nil error partial]."
  ([socket]
   (receive socket "*l"))
  ([socket pattern]
   (std.foundation.coroutine/await
    (host-call "receive" [(socket-handle socket) pattern]))))

(defn ^:async receiveany
  "Receives as soon as any data is available, up to maximum bytes. Returns
  [data nil nil] or [nil error partial]."
  [socket maximum]
  (std.foundation.coroutine/await
   (host-call "receiveany" [(socket-handle socket) maximum])))

(defn ^:async receiveuntil
  "Creates a stateful delimiter reader. Await the constructor, then await the
  returned function with no argument or one positive chunk size. The optional
  :inclusive flag includes the delimiter in the returned data."
  ([socket pattern]
   (receiveuntil socket pattern {}))
  ([socket pattern options]
   (let [handle (socket-handle socket)
         reader
         (std.foundation.coroutine/await
          (host-call "receiveuntil" [handle pattern options]))]
     (fn [& sizes]
       (if
        (> (count sizes) 1)
        (throw
         (ex-info
          "receiveuntil reader accepts at most one size"
          {:phase :socket/invalid-receiveuntil-arity
           :arguments sizes}))
        (std.foundation.coroutine/await
         (host-call
          "receiveuntil-read"
          [handle reader (get sizes 0)])))))))

(defn ^:async shutdown
  "Shuts down the TCP send direction while leaving the receive direction open.
  The only supported direction in this slice is the string send. Returns
  [1 nil] or [nil error]."
  [socket direction]
  (std.foundation.coroutine/await
   (host-call
    "shutdown"
    [(socket-handle socket) direction])))

(defn ^:async close
  "Closes the native connection. Request cleanup also closes it exactly once."
  [socket]
  (std.foundation.coroutine/await
   (host-call "close" [(socket-handle socket)])))

(defn ^:async settimeout
  "Sets connect, send and read timeouts to the same millisecond value."
  [socket milliseconds]
  (std.foundation.coroutine/await
   (host-call
    "settimeout"
    [(socket-handle socket) milliseconds])))

(defn ^:async settimeouts
  "Sets connect, send and read timeouts independently, in milliseconds."
  [socket connect-milliseconds send-milliseconds read-milliseconds]
  (std.foundation.coroutine/await
   (host-call
    "settimeouts"
    [(socket-handle socket)
     connect-milliseconds
     send-milliseconds
     read-milliseconds])))

(defn ^:async setoption
  "Sets one OpenResty-compatible TCP socket option on an established
  connection. Supported option names are keepalive, reuseaddr, tcp-nodelay,
  sndbuf, and rcvbuf. Returns [1 nil] or [nil error]."
  [socket option value]
  (std.foundation.coroutine/await
   (host-call
    "setoption"
    [(socket-handle socket) option value])))

(defn ^:async setkeepalive
  "Returns a clean established connection to its worker-local idle pool.
  Optional values set the idle timeout in milliseconds and per-key idle
  capacity. Returns [1 nil] or [nil error]. The descriptor is closed after a
  successful transfer and must not be used again."
  ([socket]
   (std.foundation.coroutine/await
    (host-call "setkeepalive" [(socket-handle socket)])))
  ([socket idle-timeout-milliseconds]
   (std.foundation.coroutine/await
    (host-call
     "setkeepalive"
     [(socket-handle socket) idle-timeout-milliseconds])))
  ([socket idle-timeout-milliseconds pool-size]
   (std.foundation.coroutine/await
    (host-call
     "setkeepalive"
     [(socket-handle socket) idle-timeout-milliseconds pool-size]))))

(defn ^:async getreusedtimes
  "Returns [count nil], where count is the number of prior worker-local pool
  checkouts for the active connection. A newly established connection reports
  zero."
  [socket]
  (std.foundation.coroutine/await
   (host-call "getreusedtimes" [(socket-handle socket)])))
