(ns hoplite.core
  (:config {:override [stream]})
  (:require [std.foundation :as foundation]))

(defn- tagged
  [kind value]
  (assoc value :hoplite/type kind))

(defn app
  "Defines one immutable Hoplite resource application."
  [definition]
  (if (map? definition)
    (tagged :application definition)
    {:hoplite/type :application
     :handler definition}))

(defn response
  "Constructs a logical response value. Response maps may also be returned directly."
  ([definition]
   (tagged :response definition))
  ([status body]
   {:hoplite/type :response
    :status status
    :body body}))

(defn- iterator-stream
  [iterator]
  (foundation/stream
   (fn [input]
     (try
       (loop []
         (if (IIterator/iter-next? input)
           (do (Coroutine/yield (IIterator/iter-next input))
               (recur))
           nil))
       (finally (IClose/close input))))
   iterator))

(defn stream
  "Constructs a backpressured HTTP body from an IStream or finite iterable."
  [source]
  (if (satisfies? IStream source)
    {:hoplite/type :stream :source source}
    (if (Iter/iter-finite? source)
      (let [iterator (IIter/iter source)]
        {:hoplite/type :stream :source (iterator-stream iterator)})
        (throw (ex-info "h/stream expects an IStream or finite iterable"
                        {:phase :stream/invalid-source})))))

(defn channel
  "Compatibility constructor for hoplite.nchan/channel."
  [definition]
  (tagged :channel definition))

(defn peer
  "Declares one WebRTC peer handler bound to a channel."
  [definition]
  (tagged :peer definition))

(defn middleware
  "Defines lifecycle middleware with request, response, error, and close phases."
  [definition]
  (tagged :middleware definition))

(defn service
  "Defines a managed application service."
  [definition]
  (tagged :service definition))

(defn module
  "Defines one composable Hoplite module exported from a package."
  [definition]
  (tagged :module definition))

(defn adapter
  "Defines an implementation of a module-owned contract."
  [definition]
  (tagged :adapter definition))

(defn store
  "Defines a store adapter through logical, atomic operations rather than tables."
  [definition]
  (tagged :store definition))

(defn package-ref
  "Selects one export from an exact package version and binds it to a local alias."
  [coordinate version export alias config]
  {:hoplite/type :package-ref
   :module/id coordinate
   :module/version version
   :module/export export
   :module/as alias
   :module/config config})
